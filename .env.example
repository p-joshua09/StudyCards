# Supabase Auth + database. Copy these into .env.local to enable accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini flashcard generation. Keep keys server-side; never prefix them NEXT_PUBLIC_.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional: allow unauthenticated Gemini testing in local development only.
# The npm dev script binds to loopback; do not expose this mode on a LAN/tunnel.
LOCAL_DEMO_AI=false

# Reserved for a future adapter. Selecting deepseek currently disables generation.
DEEPSEEK_API_KEY=
